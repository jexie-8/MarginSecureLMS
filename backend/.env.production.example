APP_NAME="Margin LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.edu
FRONTEND_URL=https://lms.example.edu
CORS_ALLOWED_ORIGINS=https://lms.example.edu
TRUSTED_PROXIES=
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=margin
DB_USERNAME=margin_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.edu
SANCTUM_STATEFUL_DOMAINS=lms.example.edu
FILESYSTEM_DISK=local
FILESYSTEM_THROW=true
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.edu
MAIL_FROM_NAME="Margin LMS"
LMS_MAIL_NOTIFICATIONS=true
QUEUE_CONNECTION=database
CLAMAV_COMMAND=clamscan
FILE_SCAN_REQUIRED=true
FILE_SCAN_TIMEOUT=30
AUDIT_RETENTION_DAYS=365
