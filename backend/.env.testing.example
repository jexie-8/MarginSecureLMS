# Copy to .env.testing for local test runs (php artisan test -c phpunit.margin.xml).
# .env.testing is ignored by git; never commit real credentials here.
APP_ENV=testing
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=margin_test
# Test runs need a PostgreSQL superuser: the row-level-security tests create
# and switch to a restricted role.
DB_USERNAME=postgres
DB_PASSWORD=change-me
