# Merge into .env; do not replace the whole file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Include ports. Example for Flutter Web local development:
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000

# Use exact origins, not *, when credentials are enabled in config/cors.php.
# Production must use HTTPS and SESSION_SECURE_COOKIE=true.

